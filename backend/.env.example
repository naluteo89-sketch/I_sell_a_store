# 백엔드 환경변수 목록 (Spring Boot는 .env 파일을 자동으로 읽지 않습니다.
# IntelliJ Run Configuration 또는 OS 환경변수로 넣어 주세요.)

YOUTUBE_API_KEY=

BRAND_NAME=I sell a store
BRAND_TAGLINE=리뷰 영상으로 먼저 보고 고르는 쇼핑
BRAND_LOGO_URL=
BRAND_PRIMARY_COLOR=#111827
BRAND_ACCENT_COLOR=#ef4444
BRAND_PHONE=000-0000-0000
BRAND_EMAIL=help@example.com
BRAND_BUSINESS_INFO=상호 · 대표 · 사업자등록번호 · 주소

FEATURE_CART=true
FEATURE_PAYMENT=true
FEATURE_REVIEWS=false
FEATURE_YOUTUBE_PANEL=true

FRONTEND_ORIGIN=http://localhost:3000

# DB 선택: mysql(기본) | h2 | postgres
SPRING_PROFILES_ACTIVE=mysql

# MySQL (기본값: localhost:3306, DB 이름 my_db, root 계정)
DB_USERNAME=root
DB_PASSWORD=MySQL_설치할_때_정한_root_비밀번호
# DB_URL은 주소·포트를 바꿀 때만 입력
# DB_URL=jdbc:mysql://localhost:3306/my_db?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
